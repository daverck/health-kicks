# HealthKicks Backend - environment variables (copy to .env and fill in)

# Database
DATABASE_URL=postgresql+psycopg2://healthkicks:healthkicks@localhost:5432/healthkicks

# AWS
AWS_REGION=eu-north-1
AWS_IOT_ENDPOINT=a2k10w7ebf2tx9-ats.iot.eu-north-1.amazonaws.com
HEALTHKICKS_INGEST_TOKEN=change-me

# Google SSO (https://console.cloud.google.com/apis/credentials)
HEALTHKICKS_GOOGLE_CLIENT_ID=
HEALTHKICKS_GOOGLE_CLIENT_SECRET=
HEALTHKICKS_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Leave empty to make the OAuth callback return JSON instead of redirecting (good for Swagger testing)
HEALTHKICKS_FRONTEND_REDIRECT_URL=

# JWT signing (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
HEALTHKICKS_JWT_SECRET=change-me
HEALTHKICKS_JWT_ALGORITHM=HS256
HEALTHKICKS_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS origins (comma separated)
HEALTHKICKS_PUBLIC_ORIGINS=http://localhost:3000
