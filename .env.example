# -----------------------------------------------------------------------------
# HealthKicks Backend - Environment Configuration Template
# -----------------------------------------------------------------------------
# Copy this file to .env (for local development) or /home/ubuntu/.env (for container deployments).
# Prefix variables with HEALTHKICKS_* or use standard names where supported.

# =============================================================================
# 1. Application & Server Environment
# =============================================================================
HEALTHKICKS_ENVIRONMENT=development
PORT=8000

# Optional: Path to custom YAML configuration file (default: ./config.yaml)
# HEALTHKICKS_CONFIG_FILE=config.yaml

# Allowed CORS origins (comma-separated).
# CRITICAL: In production (HEALTHKICKS_ENVIRONMENT=production), this cannot be empty or '*'!
HEALTHKICKS_PUBLIC_ORIGINS=http://localhost:3000,http://localhost:4200,https://healthkicks.duckdns.org

# Frontend URL for web-based OAuth redirects (tickets)
HEALTHKICKS_FRONTEND_URL=https://healthkicks.duckdns.org

# =============================================================================
# 2. Database & Migrations
# =============================================================================
# PostgreSQL / Aurora RDS connection string
DATABASE_URL=postgresql+psycopg2://healthkicks:healthkicks@localhost:5432/healthkicks

# Set to true to automatically apply Alembic migrations on startup
MIGRATE_ON_START=true

# Set to false in production so Alembic migrations manage the schema exclusively
HEALTHKICKS_AUTO_CREATE_TABLES=false

# Inactivity threshold in days for automatic device transfer (default: 30)
HEALTHKICKS_DEVICE_INACTIVITY_DAYS=30

# AWS RDS IAM database authentication (optional)
USE_RDS_IAM=false
DATABASE_SSLMODE=require

# Database connection pool resilience
HEALTHKICKS_DATABASE_POOL_SIZE=5
HEALTHKICKS_DATABASE_MAX_OVERFLOW=10
HEALTHKICKS_DATABASE_POOL_RECYCLE=300
HEALTHKICKS_DATABASE_POOL_PRE_PING=true

# =============================================================================
# 3. AWS IoT Core & Telemetry Ingestion
# =============================================================================
AWS_REGION=eu-north-1
AWS_IOT_ENDPOINT=a2k10w7ebf2tx9-ats.iot.eu-north-1.amazonaws.com
AWS_IOT_HAPTIC_COMMAND_TOPIC=healthkicks/v1/{device_id}/commands/haptic
AWS_IOT_STUDIO_START_TOPIC=healthkicks/v1/{device_id}/commands/studio/start

# IAM Role ARN for temporary scoped STS IoT sessions
HEALTHKICKS_AWS_IOT_ROLE_ARN=arn:aws:iam::123456789012:role/HealthKicksMobileIoTRole
HEALTHKICKS_AWS_STS_SESSION_DURATION=3600

# Shared secret token for the ingestion endpoint (/api/v1/ingest/event) and internal presence API
HEALTHKICKS_INGEST_TOKEN=change-me-to-a-secure-random-token

# DynamoDB table for high-frequency IMU sensor telemetry
HEALTHKICKS_DYNAMODB_TELEMETRY_TABLE=healthkicks_telemetry

# =============================================================================
# 4. Security, JWT & GDPR Privacy
# =============================================================================
# Secret key for JWT access & refresh tokens (minimum 32 chars required in production)
HEALTHKICKS_JWT_SECRET=change-me-to-a-secure-random-secret-min-32-chars
HEALTHKICKS_JWT_ALGORITHM=HS256
HEALTHKICKS_ACCESS_TOKEN_EXPIRE_MINUTES=60
HEALTHKICKS_REFRESH_TOKEN_EXPIRE_DAYS=7

# GDPR / HIPAA Deterministic Pseudonymization Pepper (minimum 32 chars required in production)
HEALTHKICKS_PSEUDONYMIZATION_PEPPER=change-me-to-a-secure-pseudonymization-pepper-min-32-chars

# =============================================================================
# 5. Single Sign-On (SSO): Google OAuth2 / OIDC
# =============================================================================
HEALTHKICKS_GOOGLE_CLIENT_ID=
HEALTHKICKS_GOOGLE_CLIENT_SECRET=
HEALTHKICKS_GOOGLE_REDIRECT_URI=https://healthkicks.duckdns.org/auth/google/callback
HEALTHKICKS_GOOGLE_MOBILE_REDIRECT_URI=https://healthkicks.duckdns.org:8443/api/v1/auth/google/callback

# =============================================================================
# 6. Single Sign-On (SSO): Microsoft Entra ID (Azure AD)
# =============================================================================
HEALTHKICKS_AZURE_CLIENT_ID=
HEALTHKICKS_AZURE_CLIENT_SECRET=
HEALTHKICKS_AZURE_TENANT_ID=common
HEALTHKICKS_AZURE_REDIRECT_URI=https://healthkicks.duckdns.org/auth/azure/callback
HEALTHKICKS_AZURE_MOBILE_REDIRECT_URI=https://healthkicks.duckdns.org:8443/api/v1/auth/azure/callback

# =============================================================================
# 7. S3 Firmware Distribution & OTA Updates
# =============================================================================
HEALTHKICKS_S3_FIRMWARE_BUCKET=healthkicks-firmware-releases
HEALTHKICKS_S3_FIRMWARE_KEY=firmware/esp32s3/latest/firmware.bin
HEALTHKICKS_S3_PRESIGNED_URL_EXPIRE_SECONDS=900

# =============================================================================
# 8. Fall Alerting & Emergency Contacts (SMTP Gmail / Escalation Worker)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Gmail App Password (16 characters, no spaces)
SMTP_PASSWORD=
SMTP_FROM_NAME="HealthKicks Alertes"

# Public backend URL used to generate signed acknowledgment links in alert emails
PUBLIC_BASE_URL=https://healthkicks.duckdns.org:8443

# Dedicated HMAC secret for signed acknowledgment tokens (defaults to JWT secret if omitted)
FALL_ALERT_ACK_SECRET=change-me-to-a-secure-ack-secret-min-32-chars

# Escalation timers and limits
FALL_ALERT_CANCEL_WINDOW_SEC=60
FALL_ALERT_ESCALATION_STEP_SEC=180
FALL_ALERT_ACK_TOKEN_TTL_SEC=7200
FALL_ALERT_REPLAY_THRESHOLD_SEC=120
FALL_ALERT_MAX_CONTACTS=5
FALL_ALERT_WORKER_INTERVAL_SEC=5
