# -----------------------------------------------------------------------------
# HealthKicks Backend - Environment Configuration Template
# -----------------------------------------------------------------------------
# Copy this file to .env or /home/ubuntu/.env in container deployments.

# --- Database & Migrations ---
# PostgreSQL / Aurora RDS connection string
DATABASE_URL=postgresql+psycopg2://healthkicks:healthkicks@localhost:5432/healthkicks

# Set to true to automatically apply Alembic migrations on container startup
MIGRATE_ON_START=true

# Set to false in production so Alembic migrations manage the schema exclusively
HEALTHKICKS_AUTO_CREATE_TABLES=false

# Inactivity threshold in days for automatic device transfer (default: 30)
HEALTHKICKS_DEVICE_INACTIVITY_DAYS=30

# Optional: Set to true if using AWS RDS IAM database authentication
USE_RDS_IAM=false
DATABASE_SSLMODE=require

# --- Application Environment ---
HEALTHKICKS_ENVIRONMENT=production

# --- AWS IoT Core ---
AWS_REGION=eu-north-1
AWS_IOT_ENDPOINT=a2k10w7ebf2tx9-ats.iot.eu-north-1.amazonaws.com
AWS_IOT_HAPTIC_COMMAND_TOPIC=healthkicks/v1/{device_id}/commands/haptic

# Shared secret token for the ingestion endpoint (/api/v1/ingest/event)
HEALTHKICKS_INGEST_TOKEN=change-me-to-a-secure-random-token

# --- Security & JWT Authentication ---
HEALTHKICKS_JWT_SECRET=change-me-to-a-secure-random-secret
HEALTHKICKS_JWT_ALGORITHM=HS256
HEALTHKICKS_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed CORS origins (comma-separated)
HEALTHKICKS_PUBLIC_ORIGINS=http://localhost:3000

# --- Google SSO OAuth2 ---
HEALTHKICKS_GOOGLE_CLIENT_ID=
HEALTHKICKS_GOOGLE_CLIENT_SECRET=
HEALTHKICKS_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
HEALTHKICKS_FRONTEND_REDIRECT_URL=http://localhost:3000
